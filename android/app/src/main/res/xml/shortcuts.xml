<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="paste_link"
        android:enabled="true"
        android:icon="@drawable/shortcut_paste"
        android:shortcutShortLabel="@string/shortcut_paste_short"
        android:shortcutLongLabel="@string/shortcut_paste_long">
        <intent
            android:action="com.arroxy.app.PASTE_LINK"
            android:targetPackage="com.arroxy.app"
            android:targetClass="com.arroxy.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_downloads"
        android:enabled="true"
        android:icon="@drawable/shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads_short"
        android:shortcutLongLabel="@string/shortcut_downloads_long">
        <intent
            android:action="com.arroxy.app.OPEN_DOWNLOADS"
            android:targetPackage="com.arroxy.app"
            android:targetClass="com.arroxy.app.MainActivity" />
    </shortcut>
</shortcuts>
